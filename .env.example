# ── Copy to `.env` and fill in. `.env` is gitignored. ────────────────────────
# Anything prefixed EXPO_PUBLIC_ is built into the app, so never put a secret
# here. The Gemini and INCI keys live in proxy/.env instead.

# Where the proxy runs. Set this to turn on live AI; leave it out to use the
# built-in simulation. On a real phone use your computer's LAN IP, not localhost.
EXPO_PUBLIC_PROXY_URL=http://localhost:3001
