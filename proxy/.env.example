# Copy this file to .env and fill in the values.
# NEVER commit .env — it is gitignored.

# Your INCI API bearer token
INCI_API_KEY=sk_live_your_key_here

# Base URL of the INCI API (no trailing slash)
# Default: https://api.inci-beauty.com/v1
# Change this if your API provider uses a different URL.
INCI_API_BASE_URL=https://api.inci-beauty.com/v1

# Port the proxy listens on locally (hosting platforms set PORT automatically)
PORT=3001
