# Copy this file to .env and fill in the values.
# NEVER commit .env — it is gitignored.

# Your INCI API bearer token
INCI_API_KEY=sk_live_your_key_here

# Base URL of the INCI API (no trailing slash)
# Default: https://api.inci-beauty.com/v1
# Change this if your API provider uses a different URL.
INCI_API_BASE_URL=https://api.inci-beauty.com/v1

# Port the proxy listens on locally (hosting platforms set PORT automatically)
PORT=3001

# Gemini key for the /ai routes. Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# Max AI requests per client IP per minute
AI_RATE_LIMIT_PER_MIN=20

# Set to 1 when deployed behind a host's load balancer (Railway, Render, Fly…)
# so rate limiting sees each phone's real IP. Leave unset when running locally.
# TRUST_PROXY=1
